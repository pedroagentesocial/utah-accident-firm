# ─────────────────────────────────────────────────────────────────────────────
# Utah Accident Firm — environment variables
# Copy to ".env" for local dev. Set the same keys in Vercel for production.
# Validated by astro:env (see astro.config.mjs). All are optional in dev so the
# site renders without them; configure before launch.
# ─────────────────────────────────────────────────────────────────────────────

# --- Contact form email (Resend) — SERVER SECRETS, never exposed to the browser
RESEND_API_KEY=
CONTACT_TO_EMAIL=          # where claim inquiries are delivered
CONTACT_FROM_EMAIL=        # verified Resend sender, e.g. claims@utahaccidentfirm.com

# --- Phone / WhatsApp — server-side (rendered into HTML), no PUBLIC_ prefix
PHONE_NUMBER=+1801XXXXXXX  # E.164; Utah area code 801 or 385
WHATSAPP_NUMBER=1801XXXXXXX # digits only for wa.me links

# --- Analytics — PUBLIC (shipped to the client for the GA4 snippet)
PUBLIC_GA4_ID=             # e.g. G-XXXXXXXXXX
