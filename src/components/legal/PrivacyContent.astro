---
/** Shared Privacy Policy body, used by the EN and ES privacy pages. */
import type { Lang } from '../../i18n/ui';
import { privacy } from '../../i18n/legal';
import LegalDisclaimer from '../LegalDisclaimer.astro';
import { nb } from '../../lib/typography';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = privacy[lang];
---
<section class="section-y">
  <div class="mx-auto max-w-2xl px-4 sm:px-6">
    <h1 class="text-[clamp(2rem,5vw,3rem)]">{nb(c.title)}</h1>
    <p class="mt-2 text-sm text-muted">{c.updated}</p>
    <p class="mt-6 text-lg leading-relaxed text-muted">{c.intro}</p>

    <div class="mt-10 space-y-9">
      {c.sections.map((s) => (
        <div>
          <h2 class="text-xl sm:text-2xl">{s.heading}</h2>
          {s.body.map((p) => (
            <p class="mt-3 leading-relaxed text-muted">{p}</p>
          ))}
        </div>
      ))}
    </div>

    <LegalDisclaimer variant="banner" class="mt-12" />
  </div>
</section>
