---
/**
 * Brand wordmark — official UAF logo (derived from public/Logo.png).
 * Horizontal lockup (Logo-horizontal.png) on ≥sm; compact monogram
 * (Logo-mark.png) on mobile, where the full lockup would crowd the controls.
 * `tone="light"` renders white for dark surfaces; over the transparent hero
 * header the overlay CSS (#site-header[data-overlay] .hdr-logo) inverts it too.
 */
interface Props {
  tone?: 'ink' | 'light';
  class?: string;
}
const { tone = 'ink', class: className = '' } = Astro.props;
const invert = tone === 'light' ? 'brightness-0 invert' : '';
---
<!-- Un solo <img> con <picture>: el navegador baja solo el logo que va a mostrar
     (antes bajaba los dos PNG, 420 KB). WebP a 2x de la altura mostrada; los PNG
     originales quedan en /public para el schema y las redes. -->
<picture>
  <source media="(min-width: 640px)" srcset="/Logo-horizontal.webp" width="522" height="96" />
  <img
    src="/Logo-mark.webp"
    alt="Utah Accident Firm"
    width="175"
    height="88"
    decoding="async"
    class={`hdr-logo h-11 w-auto object-contain lg:h-12 ${invert} ${className}`}
  />
</picture>
