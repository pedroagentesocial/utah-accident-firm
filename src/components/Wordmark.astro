---
/**
 * Brand wordmark — official UAF logo (derived from public/Logo.png).
 * Horizontal lockup (Logo-horizontal.png) on ≥sm; compact monogram
 * (Logo-mark.png) on mobile, where the full lockup would crowd the controls.
 * `tone="light"` renders white for dark surfaces; over the transparent hero
 * header the overlay CSS (#site-header[data-overlay] .hdr-logo) inverts it too.
 */
interface Props {
  tone?: 'ink' | 'light';
  class?: string;
}
const { tone = 'ink', class: className = '' } = Astro.props;
const invert = tone === 'light' ? 'brightness-0 invert' : '';
---
<!-- Mobile: monogram only -->
<img
  src="/Logo-mark.png"
  alt="Utah Accident Firm"
  width="658"
  height="330"
  decoding="async"
  class={`hdr-logo h-11 w-auto object-contain sm:hidden ${invert} ${className}`}
/>
<!-- ≥sm: full horizontal lockup -->
<img
  src="/Logo-horizontal.png"
  alt="Utah Accident Firm"
  width="2164"
  height="398"
  decoding="async"
  class={`hdr-logo hidden h-11 w-auto object-contain sm:block lg:h-12 ${invert} ${className}`}
/>
