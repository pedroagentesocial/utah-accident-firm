---
/** How it works (4): connected step path, staggered reveal (CSS, robust). */
import { getLangFromUrl } from '../../i18n/utils';
import { home } from '../../i18n/home';
import Reveal from '../ui/Reveal.astro';
import SectionLabel from '../ui/SectionLabel.astro';

const lang = getLangFromUrl(Astro.url);
const c = home[lang].how;
---
<section id="how" class="section-y bg-brand-soft/50">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <Reveal>
      <div class="max-w-2xl">
        <SectionLabel tone="brand">{c.kicker}</SectionLabel>
        <h2 class="mt-3 text-[clamp(1.9rem,4.5vw,3rem)]">{c.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-muted">{c.intro}</p>
      </div>
    </Reveal>

    <ol class="relative mt-12">
      <!-- connecting line grows in -->
      <span class="reveal-line absolute bottom-6 left-[1.125rem] top-3 w-px bg-brand/25" aria-hidden="true"></span>

      {c.steps.map((step, i) => (
        <Reveal as="li" delay={i * 120} class="relative grid grid-cols-[2.25rem_1fr] gap-4 pb-9 last:pb-0 sm:gap-6">
          <span class="z-10 grid h-9 w-9 place-items-center rounded-full bg-brand font-display text-sm font-semibold text-cream shadow-soft">
            {i + 1}
          </span>
          <div class="pt-1">
            <h3 class="text-lg sm:text-xl">{step.title}</h3>
            <p class="mt-1.5 leading-relaxed text-muted">{step.desc}</p>
          </div>
        </Reveal>
      ))}
    </ol>

    <Reveal>
      <p class="mt-4 rounded-card bg-paper px-5 py-4 text-center font-medium text-ink shadow-soft sm:text-lg">
        {c.note}
      </p>
    </Reveal>
  </div>
</section>
