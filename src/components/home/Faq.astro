---
/** FAQ: animated accordion (one open by default) + FAQPage JSON-LD. */
import { getLangFromUrl } from '../../i18n/utils';
import { home } from '../../i18n/home';
import SectionLabel from '../ui/SectionLabel.astro';

const lang = getLangFromUrl(Astro.url);
const c = home[lang].faq;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.items.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
};
---
<section id="faq" class="section-y bg-paper">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <SectionLabel tone="brand">{c.kicker}</SectionLabel>
      <h2 class="mt-3 text-[clamp(1.9rem,4.5vw,3rem)]">{c.title}</h2>
    </div>

    <div class="mt-10 divide-y divide-line border-y border-line">
      {c.items.map((it, i) => (
        <details class="group" open={i === 0} name="faq">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-left [&::-webkit-details-marker]:hidden">
            <span class="text-lg font-semibold text-ink">{it.q}</span>
            <svg class="h-5 w-5 shrink-0 text-brand transition-transform duration-300 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <div class="accordion-panel">
            <div>
              <p class="pb-5 pr-8 leading-relaxed text-muted">{it.a}</p>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
