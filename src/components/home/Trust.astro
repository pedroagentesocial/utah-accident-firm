---
/**
 * Trust: qualitative points always shown; real figures only when verified.
 * No hero-metric template, no invented numbers.
 */
import { getLangFromUrl } from '../../i18n/utils';
import { home } from '../../i18n/home';
import { trustPoints, trustStats, trustVerified } from '../../data/trust';
import Reveal from '../ui/Reveal.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import Headline from '../ui/Headline.astro';

const lang = getLangFromUrl(Astro.url);
const c = home[lang].trust;
const points = trustPoints[lang];

/** Distinct icons per trust point (languages, insurance shield, free), in order. */
const icons = [
  '<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
  '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  '<circle cx="12" cy="12" r="10"/><path d="M14.8 9A2 2 0 0 0 13 8h-2a2 2 0 0 0 0 4h2a2 2 0 0 1 0 4h-2a2 2 0 0 1-1.8-1"/><path d="M12 6v2m0 8v2"/>',
];
---
<section class="section-y bg-accent-soft/40">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <Reveal>
      <div class="max-w-2xl">
        <SectionLabel tone="accent">{c.kicker}</SectionLabel>
        <Headline class="mt-3 text-[clamp(1.9rem,4.5vw,3rem)]" text={c.title} />
        <p class="mt-4 text-lg leading-relaxed text-muted">{c.intro}</p>
      </div>
    </Reveal>

    <div class="mt-10 grid gap-5 sm:grid-cols-3">
      {points.map((point, i) => (
        <Reveal delay={i * 80} class="rounded-card border border-line bg-paper p-6 shadow-soft transition-shadow duration-300 hover:shadow-lift">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-brand-soft text-brand">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i]} />
          </span>
          <p class="mt-4 font-medium leading-snug text-ink">{point}</p>
        </Reveal>
      ))}
    </div>

    {trustVerified && (
      <Reveal class="mt-10 flex flex-wrap items-end gap-x-10 gap-y-5 border-t border-line pt-8">
        {trustStats.map((s) => (
          <div>
            <div class="font-display text-3xl font-semibold text-brand sm:text-4xl">{s.value}</div>
            <div class="mt-1 text-sm text-muted">{s.label[lang]}</div>
          </div>
        ))}
      </Reveal>
    )}
  </div>
</section>
