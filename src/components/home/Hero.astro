---
/**
 * Hero: full-bleed Utah-road background with a slow Ken Burns drift, dark
 * overlay for legibility, and the relief-first message + contact channels on
 * top. Pulls up under the fixed header (which is transparent over this section
 * and turns solid once you scroll past it). [STOCK PROVISIONAL — foto real]
 */
import { getLangFromUrl } from '../../i18n/utils';
import { home } from '../../i18n/home';
import { images } from '../../data/images';
import HeroCarousel from '../islands/HeroCarousel.tsx';
import ContactChannels from '../ui/ContactChannels.astro';

const lang = getLangFromUrl(Astro.url);
const c = home[lang].hero;

// Each carousel slide pairs a background (video / image) with its own copy.
const slides = [
  { type: 'video' as const, src: images.contactVideo.src, poster: images.heroBg.src, alt: images.contactVideo.alt[lang] },
  { type: 'image' as const, src: images.heroBg.src, alt: images.heroBg.alt[lang] },
];
const copy = c.slides;
---
<section id="hero" class="relative -mt-16 flex min-h-[88svh] items-center overflow-hidden bg-ink">
  <!-- Background carousel (video + image), each with its own headline + dots/arrows.
       The contact channels + reassurance below stay constant across slides. -->
  <HeroCarousel
    client:load
    slides={slides}
    copy={copy}
    lang={lang}
    prevLabel={lang === 'es' ? 'Anterior' : 'Previous'}
    nextLabel={lang === 'es' ? 'Siguiente' : 'Next'}
  >
    <ContactChannels tone="onband" class="pointer-events-auto mt-8" />

    <p class="mt-6 flex items-center gap-2 text-sm font-medium text-cream/90">
      <svg class="h-5 w-5 shrink-0 text-brand-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5" />
      </svg>
      {c.reassurance}
    </p>
  </HeroCarousel>
</section>
