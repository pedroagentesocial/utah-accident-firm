---
/** Why us: side-by-side contrast, "on your own" vs "with us". */
import { getLangFromUrl } from '../../i18n/utils';
import { home } from '../../i18n/home';
import Reveal from '../ui/Reveal.astro';
import SectionLabel from '../ui/SectionLabel.astro';

const lang = getLangFromUrl(Astro.url);
const c = home[lang].why;
---
<section id="why" class="section-y bg-paper">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <Reveal>
      <div class="max-w-2xl">
        <SectionLabel tone="brand">{c.kicker}</SectionLabel>
        <h2 class="mt-3 text-[clamp(1.9rem,4.5vw,3rem)]">{c.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-muted">{c.intro}</p>
      </div>
    </Reveal>

    <div class="mt-10 grid gap-5 md:grid-cols-2 md:gap-6">
      <Reveal class="rounded-card border border-line bg-paper-2 p-6 sm:p-8">
        <h3 class="text-lg text-muted">{c.aloneTitle}</h3>
        <ul role="list" class="mt-5 space-y-3.5">
          {c.alone.map((point) => (
            <li class="flex items-start gap-3 text-fg">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M18 6 6 18M6 6l12 12" />
              </svg>
              <span class="leading-snug">{point}</span>
            </li>
          ))}
        </ul>
      </Reveal>

      <Reveal delay={100} class="rounded-card bg-brand p-6 text-cream shadow-lift sm:p-8">
        <h3 class="text-lg text-cream">{c.withUsTitle}</h3>
        <ul role="list" class="mt-5 space-y-3.5">
          {c.withUs.map((point) => (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              <span class="leading-snug text-cream">{point}</span>
            </li>
          ))}
        </ul>
      </Reveal>
    </div>
  </div>
</section>
