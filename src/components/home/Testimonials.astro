---
/**
 * Testimonials. Renders the animated deck carousel. When no real, consented
 * reviews exist yet, it shows clearly-labeled DEMO samples (badge + note) so the
 * design can be previewed without ever passing fabricated quotes off as real.
 */
import { getLangFromUrl } from '../../i18n/utils';
import { home } from '../../i18n/home';
import { displayTestimonials, testimonialsAreSamples } from '../../data/testimonials';
import TestimonialsCarousel from '../islands/TestimonialsCarousel.tsx';
import Reveal from '../ui/Reveal.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import Headline from '../ui/Headline.astro';

const lang = getLangFromUrl(Astro.url);
const c = home[lang].testimonials;
---
<section class="section-y bg-brand-soft/40">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <Reveal>
      <div class="max-w-2xl">
        <div class="flex flex-wrap items-center gap-3">
          <SectionLabel tone="brand">{c.kicker}</SectionLabel>
          {testimonialsAreSamples && (
            <span class="inline-flex items-center gap-1.5 rounded-pill border border-line bg-paper px-2.5 py-1 text-[0.7rem] font-semibold uppercase tracking-wide text-muted">
              <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v4h1" /></svg>
              {c.sampleBadge}
            </span>
          )}
        </div>
        <Headline class="mt-3 text-[clamp(1.9rem,4.5vw,3rem)]" text={c.title} />
        <p class="mt-4 text-lg leading-relaxed text-muted">{testimonialsAreSamples ? c.sampleNote : c.intro}</p>
      </div>
    </Reveal>

    <div class="mt-10">
      <TestimonialsCarousel
        client:visible
        items={displayTestimonials}
        lang={lang}
        prevLabel={lang === 'es' ? 'Anterior' : 'Previous'}
        nextLabel={lang === 'es' ? 'Siguiente' : 'Next'}
      />
    </div>
  </div>
</section>
