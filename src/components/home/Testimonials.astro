---
/**
 * Testimonials. Real reviews only: when present, render the carousel island;
 * when empty, show an honest "coming soon" state (never fabricated quotes).
 */
import { getLangFromUrl } from '../../i18n/utils';
import { home } from '../../i18n/home';
import { testimonials, hasTestimonials } from '../../data/testimonials';
import TestimonialsCarousel from '../islands/TestimonialsCarousel.tsx';
import Reveal from '../ui/Reveal.astro';
import SectionLabel from '../ui/SectionLabel.astro';

const lang = getLangFromUrl(Astro.url);
const c = home[lang].testimonials;
---
<section class="section-y bg-brand-soft/40">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <Reveal>
      <div class="max-w-2xl">
        <SectionLabel tone="brand">{c.kicker}</SectionLabel>
        <h2 class="mt-3 text-[clamp(1.9rem,4.5vw,3rem)]">{c.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-muted">{c.intro}</p>
      </div>
    </Reveal>

    <div class="mt-10">
      {hasTestimonials ? (
        <TestimonialsCarousel
          client:visible
          items={testimonials}
          lang={lang}
          prevLabel="‹"
          nextLabel="›"
        />
      ) : (
        <div class="rounded-card border border-dashed border-line bg-paper p-8 text-center sm:p-12">
          <span class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-brand-soft text-brand">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z" />
            </svg>
          </span>
          <h3 class="mt-4 font-display text-xl font-semibold text-ink">{c.emptyTitle}</h3>
          <p class="mx-auto mt-2 max-w-md text-muted">{c.emptyBody}</p>
        </div>
      )}
    </div>
  </div>
</section>
