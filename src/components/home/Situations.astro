---
/** Situations we handle: chip cluster over a Utah landscape band. */
import { getLangFromUrl } from '../../i18n/utils';
import { home } from '../../i18n/home';
import { images } from '../../data/images';
import Reveal from '../ui/Reveal.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import Headline from '../ui/Headline.astro';

const lang = getLangFromUrl(Astro.url);
const c = home[lang].situations;
const img = images.utahRoad;
---
<section id="situations" class="relative overflow-hidden">
  <img src={img.src} alt={img.alt[lang]} width="1800" height="900" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
  {/* [STOCK PROVISIONAL — reemplazar con foto real de Utah] */}
  <div class="absolute inset-0" style="background: linear-gradient(180deg, rgb(21 62 106 / 0.93), rgb(14 44 77 / 0.85));" aria-hidden="true"></div>

  <div class="relative section-y mx-auto max-w-5xl px-4 sm:px-6">
    <Reveal>
      <div class="max-w-4xl">
        <SectionLabel tone="band">{c.kicker}</SectionLabel>
        <Headline class="mt-3 text-cream text-[clamp(1.9rem,4.5vw,3rem)]" text={c.title} />
        <p class="mt-4 text-lg leading-relaxed text-cream/85">{c.intro}</p>
      </div>
    </Reveal>

    {/* `flex-auto` lets each row grow to the full width, so the leftovers on the
        last row stretch instead of leaving a lone chip hanging on the left. */}
    <Reveal delay={100} class="mt-8 flex flex-wrap gap-2.5 sm:gap-3">
      {c.items.map((item) => (
        <span class="flex flex-auto items-center justify-center gap-2 rounded-pill border border-cream/25 bg-cream/10 px-4 py-2 text-center text-sm font-medium text-cream backdrop-blur-sm">
          <svg class="h-4 w-4 shrink-0 text-brand-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5" />
          </svg>
          {item}
        </span>
      ))}
    </Reveal>
  </div>
</section>
