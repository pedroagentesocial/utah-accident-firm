---
/**
 * "Start your claim" section: a dedicated, high-intent block right after the Hero.
 * Three clickable quizzes (claim / coverage / repair) that capture the lead. The
 * QuizLauncher is a React island, hydrated on scroll (client:visible) to stay off
 * the critical path.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { privacyHref, telHref, whatsappHref } from '../../lib/contact';
import SectionLabel from '../ui/SectionLabel.astro';
import Headline from '../ui/Headline.astro';
import Reveal from '../ui/Reveal.astro';
import QuizLauncher from '../islands/QuizLauncher';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const q = t.quiz;
---

<section id="start" class="section-y scroll-mt-20 bg-paper-2">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <Reveal class="mx-auto max-w-2xl text-center">
      <SectionLabel tone="brand">{q.kicker}</SectionLabel>
      <Headline class="mt-3 text-[clamp(1.7rem,3.4vw,2.4rem)]" text={q.title} />
      <p class="mt-3 leading-relaxed text-muted">{q.intro}</p>
    </Reveal>

    <Reveal delay={80} class="mt-10">
      <QuizLauncher
        client:visible
        lang={lang}
        chrome={q}
        pickLabel={q.pick}
        privacyHref={privacyHref(lang)}
        callHref={telHref}
        waHref={whatsappHref(lang)}
        callLabel={t.channels.callShort}
        waLabel={t.channels.whatsapp}
      />
    </Reveal>
  </div>
</section>
