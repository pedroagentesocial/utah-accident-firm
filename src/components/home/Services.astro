---
/** What we do (3): editorial numbered rows, alternating, not an icon-card grid. */
import { getLangFromUrl } from '../../i18n/utils';
import { home } from '../../i18n/home';
import Reveal from '../ui/Reveal.astro';
import SectionLabel from '../ui/SectionLabel.astro';

const lang = getLangFromUrl(Astro.url);
const c = home[lang].services;

/** Line icons per service (clipboard-check, scale, wrench), order matches items. */
const icons = [
  '<rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/>',
  '<path d="M16 16l3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M2 16l3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>',
  '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
];
---
<section id="services" class="section-y bg-paper">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <Reveal>
      <div class="max-w-2xl">
        <SectionLabel tone="brand">{c.kicker}</SectionLabel>
        <h2 class="mt-3 text-[clamp(1.9rem,4.5vw,3rem)]">{c.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-muted">{c.intro}</p>
      </div>
    </Reveal>

    <ol class="mt-12 divide-y divide-line border-y border-line">
      {c.items.map((item, i) => (
        <li>
          <Reveal delay={i * 80}>
            <div class="grid items-start gap-3 py-8 sm:grid-cols-[auto_1fr] sm:gap-8 sm:py-10">
              <span class="font-display text-3xl font-semibold text-accent-deep sm:text-5xl">{item.n}</span>
              <div class="max-w-2xl">
                <div class="flex items-center gap-3">
                  <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-brand-soft text-brand-deep">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i]} />
                  </span>
                  <h3 class="text-xl sm:text-2xl">{item.title}</h3>
                </div>
                <p class="mt-2.5 leading-relaxed text-muted">{item.desc}</p>
              </div>
            </div>
          </Reveal>
        </li>
      ))}
    </ol>
  </div>
</section>
