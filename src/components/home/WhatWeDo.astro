---
/**
 * What we do + How it works, combined into one section as two side-by-side
 * lists: services (numbered, no icons) on the left, the process steps (with a
 * connecting path) on the right. Stacks to one column on small screens.
 */
import { getLangFromUrl } from '../../i18n/utils';
import { home } from '../../i18n/home';
import Reveal from '../ui/Reveal.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import Headline from '../ui/Headline.astro';

const lang = getLangFromUrl(Astro.url);
const s = home[lang].services;
const h = home[lang].how;

/** Line icons per step (phone, message, shield-check, car), order matches steps. */
const stepIcons = [
  '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
  '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
  '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  '<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>',
];
---
<section id="services" class="section-y scroll-mt-20 bg-paper">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16">
    <!-- Left: what we do (numbered, no icons) -->
    <div>
      <Reveal>
        <SectionLabel tone="brand">{s.kicker}</SectionLabel>
        <Headline class="mt-3 text-[clamp(1.7rem,3.2vw,2.3rem)]" text={s.title} />
        <p class="mt-3 leading-relaxed text-muted">{s.intro}</p>
      </Reveal>

      <ol class="mt-8 divide-y divide-line border-y border-line">
        {s.items.map((item, i) => (
          <li>
            <Reveal delay={i * 80}>
              <div class="grid grid-cols-[auto_1fr] items-baseline gap-4 py-6 sm:gap-5">
                <span class="font-display text-2xl font-semibold text-accent-deep sm:text-3xl">{item.n}</span>
                <div>
                  <h3 class="text-lg sm:text-xl">{item.title}</h3>
                  <p class="mt-2 leading-relaxed text-muted">{item.desc}</p>
                </div>
              </div>
            </Reveal>
          </li>
        ))}
      </ol>
    </div>

    <!-- Right: how it works (connected step path) -->
    <div id="how" class="scroll-mt-24 rounded-card bg-brand-soft/40 p-6 sm:p-8 lg:p-9">
      <Reveal>
        <SectionLabel tone="brand">{h.kicker}</SectionLabel>
        <Headline class="mt-3 text-[clamp(1.7rem,3.2vw,2.3rem)]" text={h.title} />
        <p class="mt-3 leading-relaxed text-muted">{h.intro}</p>
      </Reveal>

      <ol class="relative mt-8">
        <span class="reveal-line absolute bottom-6 left-[1.125rem] top-3 w-px bg-brand/25" aria-hidden="true"></span>

        {h.steps.map((step, i) => (
          <Reveal as="li" delay={i * 120} class="relative grid grid-cols-[2.25rem_1fr] gap-4 pb-8 last:pb-0 sm:gap-5">
            <span class="z-10 grid h-9 w-9 place-items-center rounded-full bg-brand font-display text-sm font-semibold text-cream shadow-soft">
              {i + 1}
            </span>
            <div class="pt-1">
              <div class="flex items-center gap-2.5">
                <svg class="h-5 w-5 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={stepIcons[i]} />
                <h3 class="text-base sm:text-lg">{step.title}</h3>
              </div>
              <p class="mt-1.5 leading-relaxed text-muted">{step.desc}</p>
            </div>
          </Reveal>
        ))}
      </ol>

      <Reveal>
        <p class="mt-4 rounded-card bg-paper px-5 py-4 text-center font-medium text-ink shadow-soft">
          {h.note}
        </p>
      </Reveal>
    </div>
  </div>
</section>
