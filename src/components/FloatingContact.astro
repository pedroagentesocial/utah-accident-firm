---
/**
 * Floating combined contact: Call + WhatsApp, always visible on every viewport.
 * tel: is direct; WhatsApp goes through /api/wa (server-side number, anti-spam).
 * Sober micro-interaction (hover/active scale) via CSS; respects reduced-motion.
 */
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { telHref, whatsappHref } from '../lib/contact';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const wa = whatsappHref(lang);
---
<div
  class="fixed bottom-4 right-4 z-40 flex items-center gap-2.5"
  style="padding-bottom: env(safe-area-inset-bottom)"
>
  <a
    href={telHref}
    aria-label={t.channels.call}
    class="group inline-flex h-12 items-center gap-2 rounded-pill bg-accent px-3.5 font-semibold text-ink shadow-lift transition-transform duration-200 hover:scale-105 active:scale-95 sm:h-14 sm:px-5"
  >
    <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
    </svg>
    <span class="hidden text-sm sm:inline">{t.channels.callShort}</span>
  </a>

  <a
    href={wa}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t.channels.whatsapp}
    style="background-color: oklch(0.49 0.13 152)"
    class="group inline-flex h-12 items-center gap-2 rounded-pill px-3.5 font-semibold text-cream shadow-lift transition-transform duration-200 hover:scale-105 active:scale-95 sm:h-14 sm:px-5"
  >
    <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.47 14.38c-.3-.15-1.74-.86-2-.95-.27-.1-.46-.15-.66.15-.2.29-.76.94-.93 1.13-.17.2-.34.22-.64.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.34.44-.51.15-.17.2-.29.3-.49.1-.2.05-.37-.02-.52-.08-.15-.66-1.6-.91-2.19-.24-.57-.48-.5-.66-.5l-.56-.01c-.2 0-.52.07-.79.37-.27.29-1.04 1.01-1.04 2.47 0 1.46 1.06 2.86 1.21 3.06.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.74-.71 1.99-1.4.24-.69.24-1.28.17-1.4-.07-.13-.27-.2-.56-.35Z" />
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.13a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.37c0-4.54 3.7-8.23 8.23-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.69 8.23-8.23 8.23Z" />
    </svg>
    <span class="hidden text-sm sm:inline">{t.channels.whatsapp}</span>
  </a>
</div>
