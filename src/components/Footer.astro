---
/** Site footer — NAP, hours, service area, nav, and the mandatory disclaimer. */
import Wordmark from './Wordmark.astro';
import LegalDisclaimer from './LegalDisclaimer.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import { business } from '../data/business';
import { privacyHref } from '../lib/contact';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localize = useTranslatedPath(lang);
const home = localize();
const a = business.address;
const year = new Date().getFullYear();

// Home-anchored links (work from any page, including legal pages).
const links = [
  { href: `${home}#how`, label: t.nav.how },
  { href: `${home}#services`, label: t.nav.services },
  { href: `${home}#situations`, label: t.nav.situations },
  { href: `${home}#faq`, label: t.nav.faq },
  { href: `${home}#contact`, label: t.nav.contact },
];
---
<footer class="border-t border-line bg-paper-2">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-4">
    <div class="md:col-span-1">
      <Wordmark />
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">{t.footer.tagline}</p>
    </div>

    <nav aria-label="Footer">
      <p class="text-sm font-semibold text-ink">{t.nav.menu}</p>
      <ul role="list" class="mt-3 space-y-2 text-sm">
        {links.map((l) => (
          <li><a href={l.href} class="text-muted transition-colors hover:text-brand">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <p class="text-sm font-semibold text-ink">{t.footer.contact}</p>
      <address class="mt-3 text-sm not-italic leading-relaxed text-muted">
        {a.street}<br />{a.city}, {a.region} {a.postalCode}
        <a href={`tel:${business.phone}`} class="mt-2 block font-medium text-brand hover:underline">{business.phoneDisplay}</a>
        <a href={`mailto:${business.email}`} class="block font-medium text-brand hover:underline">{business.email}</a>
      </address>

      <p class="mt-5 text-sm font-semibold text-ink">{t.footer.hours}</p>
      <ul role="list" class="mt-2 space-y-1 text-sm text-muted">
        {business.hours.map((h) => (
          <li>
            {t.weekdays[h.days[0]]}{h.days.length > 1 ? `–${t.weekdays[h.days[h.days.length - 1]]}` : ''}: {h.opens}–{h.closes}
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-ink">{t.footer.serving}</p>
      <p class="mt-3 text-sm leading-relaxed text-muted">{business.areaServed.cities.join(' · ')}</p>

      {(business.social.facebook || business.social.instagram) && (
        <div class="mt-5 flex gap-3">
          {business.social.facebook && (
            <a href={business.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="grid h-9 w-9 place-items-center rounded-full border border-line text-muted transition-colors hover:border-brand hover:text-brand">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H8v3h3v7h3v-7h2.5l.5-3H14V9.5c0-.3.2-.5.5-.5Z" /></svg>
            </a>
          )}
          {business.social.instagram && (
            <a href={business.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="grid h-9 w-9 place-items-center rounded-full border border-line text-muted transition-colors hover:border-brand hover:text-brand">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
            </a>
          )}
        </div>
      )}
    </div>
  </div>

  <!-- MANDATORY legal disclaimer — always visible -->
  <div class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 pb-24 pt-6 sm:px-6">
      {/* extra bottom space so the floating contact button never covers content */}
      <LegalDisclaimer variant="footer" />
      <div class="mt-4 flex flex-col gap-2 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
        <p>© {year} {business.name}. {t.footer.rights}</p>
        <a href={privacyHref(lang)} class="font-medium text-fg transition-colors hover:text-brand">{t.footer.privacy}</a>
      </div>
    </div>
  </div>
</footer>
