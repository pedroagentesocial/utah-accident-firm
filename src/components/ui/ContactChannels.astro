---
/**
 * The three contact channels (Call · WhatsApp · Form), reused in hero, contact
 * section, and elsewhere. `layout` controls arrangement; `tone` adapts to the
 * teal band.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { business } from '../../data/business';
import { telHref, whatsappHref } from '../../lib/contact';

interface Props {
  layout?: 'row' | 'stack';
  tone?: 'default' | 'onband';
  class?: string;
}
const { layout = 'row', tone = 'default', class: className = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const wa = whatsappHref(lang);

const wrap =
  layout === 'row'
    ? 'flex flex-col gap-3 sm:flex-row sm:flex-wrap'
    : 'grid gap-3';

const callCls =
  tone === 'onband'
    ? 'bg-cream text-ink hover:bg-paper'
    : 'bg-accent text-cream hover:bg-accent-deep';
const waCls = 'text-cream hover:opacity-90';
const formCls =
  tone === 'onband'
    ? 'border border-cream/40 text-cream hover:bg-cream/10'
    : 'border border-line text-fg hover:border-brand hover:text-brand';
---
<div class={`${wrap} ${className}`}>
  <a
    href={telHref}
    class={`inline-flex items-center justify-center gap-2 rounded-pill px-5 py-3 text-sm font-semibold transition active:scale-[0.98] shadow-soft ${callCls}`}
  >
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
    </svg>
    {t.channels.call} · {business.phoneDisplay}
  </a>

  <a
    href={wa}
    target="_blank"
    rel="noopener noreferrer"
    style="background-color: var(--color-wa)"
    class={`inline-flex items-center justify-center gap-2 rounded-pill px-5 py-3 text-sm font-semibold transition active:scale-[0.98] shadow-soft ${waCls}`}
  >
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.47 14.38c-.3-.15-1.74-.86-2-.95-.27-.1-.46-.15-.66.15-.2.29-.76.94-.93 1.13-.17.2-.34.22-.64.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.34.44-.51.15-.17.2-.29.3-.49.1-.2.05-.37-.02-.52-.08-.15-.66-1.6-.91-2.19-.24-.57-.48-.5-.66-.5l-.56-.01c-.2 0-.52.07-.79.37-.27.29-1.04 1.01-1.04 2.47 0 1.46 1.06 2.86 1.21 3.06.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.74-.71 1.99-1.4.24-.69.24-1.28.17-1.4-.07-.13-.27-.2-.56-.35Z" />
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.13a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.37c0-4.54 3.7-8.23 8.23-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.69 8.23-8.23 8.23Z" />
    </svg>
    {t.channels.whatsapp}
  </a>

  <a
    href="#contact"
    class={`inline-flex items-center justify-center gap-2 rounded-pill px-5 py-3 text-sm font-semibold transition active:scale-[0.98] ${formCls}`}
  >
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z" />
    </svg>
    {t.channels.form}
  </a>
</div>
