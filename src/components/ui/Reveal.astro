---
/**
 * Scroll-reveal wrapper (CSS + IntersectionObserver, no island/hydration).
 * Content is visible by default; only `html.js` hides-then-reveals it, so a
 * JS failure can never blank a section. The observer lives in BaseLayout.
 */
interface Props {
  delay?: number; // ms
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}
const { delay = 0, as = 'div', class: className = '' } = Astro.props;
const Tag = as as any;
---
<Tag class={`reveal ${className}`} style={delay ? `--reveal-delay:${delay}ms` : undefined}>
  <slot />
</Tag>
