---
/** Toggles between the EN and ES versions of the current page. */
import { getLangFromUrl, getAlternatePath, useTranslations } from '../i18n/utils';
import { languages, type Lang } from '../i18n/ui';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const other: Lang = lang === 'en' ? 'es' : 'en';
const href = getAlternatePath(Astro.url, other);
---
<a
  href={href}
  hreflang={other === 'en' ? 'en-US' : 'es-US'}
  aria-label={`${t.common.langLabel}: ${languages[other]}`}
  class={`inline-flex h-10 items-center gap-1.5 rounded-pill border border-line px-3 text-sm font-medium text-fg transition-colors hover:border-brand hover:text-brand ${className}`}
>
  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
  </svg>
  {other === 'en' ? 'EN' : 'ES'}
</a>
