---
/**
 * Sticky header. Wordmark + anchor nav + the three contact channels.
 * Desktop: nav + Call/WhatsApp/Form + language. Mobile: compact Call + WhatsApp
 * icons always visible, nav in a menu (the form CTA also lives in the sticky
 * bottom bar). Anchors target the long-scroll home sections.
 */
import Wordmark from './Wordmark.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import { business } from '../data/business';
import { telHref, whatsappHref } from '../lib/contact';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localize = useTranslatedPath(lang);
const home = localize();
const wa = whatsappHref(lang);

// Home-anchored links (work from any page, e.g. the privacy page).
const links = [
  { href: `${home}#how`, label: t.nav.how },
  { href: `${home}#services`, label: t.nav.services },
  { href: `${home}#situations`, label: t.nav.situations },
  { href: `${home}#faq`, label: t.nav.faq },
  { href: `${home}#contact`, label: t.nav.contact },
];
---
<header class="sticky top-0 z-50 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-4 py-3 sm:px-6">
    <a href={home} class="inline-flex shrink-0" aria-label={business.name}>
      <Wordmark />
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class="text-sm font-medium text-fg transition-colors hover:text-brand">{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher />

      <!-- Mobile: compact Call icon (WhatsApp lives in the menu + floating button) -->
      <a href={telHref} aria-label={t.channels.call} class="grid h-10 w-10 place-items-center rounded-pill bg-accent text-ink shadow-soft transition-colors hover:bg-accent-deep sm:hidden">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
        </svg>
      </a>
      <!-- Tablet/desktop: WhatsApp icon -->
      <a href={wa} target="_blank" rel="noopener noreferrer" aria-label={t.channels.whatsapp} class="hidden h-10 w-10 place-items-center rounded-pill text-cream shadow-soft sm:grid" style="background-color: oklch(0.49 0.13 152)">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.47 14.38c-.3-.15-1.74-.86-2-.95-.27-.1-.46-.15-.66.15-.2.29-.76.94-.93 1.13-.17.2-.34.22-.64.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.34.44-.51.15-.17.2-.29.3-.49.1-.2.05-.37-.02-.52-.08-.15-.66-1.6-.91-2.19-.24-.57-.48-.5-.66-.5l-.56-.01c-.2 0-.52.07-.79.37-.27.29-1.04 1.01-1.04 2.47 0 1.46 1.06 2.86 1.21 3.06.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.74-.71 1.99-1.4.24-.69.24-1.28.17-1.4-.07-.13-.27-.2-.56-.35Z" />
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.13a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.37c0-4.54 3.7-8.23 8.23-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.69 8.23-8.23 8.23Z" />
        </svg>
      </a>

      <!-- Desktop: Call + Form CTA -->
      <a href={telHref} class="hidden items-center gap-2 rounded-pill bg-accent px-4 py-2 text-sm font-semibold text-ink shadow-soft transition-colors hover:bg-accent-deep sm:inline-flex">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
        </svg>
        {business.phoneDisplay}
      </a>
      <a href={`${home}#contact`} class="hidden rounded-pill bg-brand px-4 py-2 text-sm font-semibold text-cream shadow-soft transition-colors hover:bg-brand-deep lg:inline-flex">
        {t.nav.getStarted}
      </a>

      <!-- Mobile nav menu -->
      <details class="relative lg:hidden [&:not([open])>div]:hidden">
        <summary class="grid h-10 w-10 cursor-pointer list-none place-items-center rounded-pill border border-line text-fg [&::-webkit-details-marker]:hidden" aria-label={t.nav.menu}>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <div class="absolute right-0 mt-2 w-60 rounded-card border border-line bg-paper p-2 shadow-lift">
          <nav class="grid" aria-label="Mobile">
            {links.map((l) => (
              <a href={l.href} class="rounded-lg px-3 py-2.5 text-sm font-medium text-fg hover:bg-brand-soft hover:text-brand">{l.label}</a>
            ))}
            <a href={wa} target="_blank" rel="noopener noreferrer" class="rounded-lg px-3 py-2.5 text-sm font-medium text-fg hover:bg-brand-soft hover:text-brand">{t.channels.whatsapp}</a>
            <a href={`${home}#contact`} class="mt-1 rounded-lg bg-brand px-3 py-2.5 text-center text-sm font-semibold text-cream">
              {t.nav.getStarted}
            </a>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
