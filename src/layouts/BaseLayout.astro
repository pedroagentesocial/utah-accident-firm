---
/** Shared page shell: <head> SEO, header, footer, view transitions. */
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/seo/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { HREFLANG } from '../config/site';

interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<!doctype html>
<html lang={HREFLANG[lang]}>
  <head>
    {/* Flag JS before paint so reveals hide-then-animate; no JS = content stays visible. */}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <BaseHead title={title} description={description} image={image} />
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-paper text-fg">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-pill focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:text-paper"
    >
      {t.common.skipToContent}
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <FloatingContact />

    <!-- Scroll reveal: visible by default; this only animates them in. -->
    <script>
      function initReveal() {
        const els = document.querySelectorAll<HTMLElement>('.reveal:not(.is-visible), .reveal-line:not(.is-visible)');
        if (!els.length) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
        // Safety net: if anything is still hidden after load, reveal it.
        window.setTimeout(() => {
          document.querySelectorAll('.reveal:not(.is-visible), .reveal-line:not(.is-visible)').forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.top < window.innerHeight) el.classList.add('is-visible');
          });
        }, 1200);
      }
      initReveal();
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
