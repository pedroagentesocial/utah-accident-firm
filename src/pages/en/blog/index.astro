---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogIndex from '../../../components/blog/BlogIndex.astro';
import { blog } from '../../../i18n/blog';
import { getPosts } from '../../../lib/blog';

const c = blog.en;
// While every post is a draft, keep the empty index out of the search index.
const noindex = (await getPosts('en')).length === 0;
---

<BaseLayout title={c.seoTitle} description={c.seoDescription} noindex={noindex}>
  <BlogIndex lang="en" />
</BaseLayout>
