---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import WhatWeDo from '../../components/home/WhatWeDo.astro';
import WhyUs from '../../components/home/WhyUs.astro';
import Situations from '../../components/home/Situations.astro';
import Trust from '../../components/home/Trust.astro';
import Testimonials from '../../components/home/Testimonials.astro';
import Faq from '../../components/home/Faq.astro';
import ContactSection from '../../components/home/ContactSection.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('es');
---
<BaseLayout title={t.seo.home.title} description={t.seo.home.description}>
  <Hero />
  <WhatWeDo />
  <WhyUs />
  <Situations />
  <Trust />
  <Testimonials />
  <Faq />
  <ContactSection />
</BaseLayout>
